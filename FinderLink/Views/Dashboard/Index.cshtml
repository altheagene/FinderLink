@{
    ViewData["Title"] = "Dashboard";
    var colorPalette = new[]
    {
    "#c4b800", // warm yellow
    "#c05a18", // burnt orange
    "#1a6aad", // muted blue
    "#8b5e3c", // warm brown
    "#7a6300", // dark gold
    "#a04515", // deep orange
    "#b8860b", // dark goldenrod
    "#6b4f2a", // deep brown
    "#c47a00", // amber
    "#5a4a8b", // muted purple
};

    var colors = LookupData.Categories
        .Select((cat, i) => new { cat, color = colorPalette[i % colorPalette.Length] })
        .ToDictionary(x => x.cat, x => x.color);
}

<style>
    /* ===== DASHBOARD BASE ===== */


    .page {
        min-height: 100vh;
        color: #1e1b2e;
        padding: 2rem;
    }

    /* HEADER */
    .page-header h1 {
        font-size: 26px;
        margin-bottom: 5px;
        font-weight: 700
    }

    .page-header p {
        color: #6b7280;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    /* ===== STAT CARDS ===== */
    .stat-card {
        background: white;
        min-height: 140px;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #ece9f5;
        transition: 0.2s;
        box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
        font-family: 'Spline Sans Mono', monospace;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .stat-label {
        font-size: 12px;
        margin-bottom: 5px;
        color: #5C524A;
        font-weight: 600;
        display: block;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(124, 58, 237, 0.1);
           
        }

        .stat-card h3 {
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0;
            color: #000000;

           
        }

    /* ===== PANELS ===== */
    .card-dark {
        background: #FFFEFC;
        border-radius: 14px;
        padding: 20px;
        border: 1px solid #ece9f5;
    }

        .card-dark p {
            font-size: 0.8rem;
            font-weight: 500;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid #eee;
            font-family: 'Spline Sans Mono', monospace;
            color: #9c8e82;
        }

    /* ===== TABLE ===== */
    .table {
        background: transparent !important;
        color: #1e1b2e;
        border-bottom: 1px solid rgba(92, 82, 74, 0.6)
    }

        .table th {
            font-size: 12px;
            color: rgba(92, 82, 74, 0.8);
            font-family: 'Spline Sans Mono', monospace;
        }

        .table td {
            font-size: 14px;
            border-top: 1px solid #eee;
        }

    /* ===== BADGE ===== */
    .badge {
        background: #ede9fe !important;
        color: #5b21b6 !important;
        font-size: 11px;
    }
</style>

<div class="page">

    <!-- HEADER -->
    <div class="page-header">
        <h1>Dashboard</h1>
        <p>Overview of Lost & Found system activity</p>
    </div>

    <!-- STATS -->
    <div class="card-dark mb-4" style="padding: 1.2rem;">

        <!-- CARD HEADER -->
        <div style="margin-bottom: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid #ece9f5;">
            <div style="font-size: 15px; font-weight: 700; color: #1e1b2e; margin-bottom: 2px;">Item Status Overview</div>
            <div style="font-size: 12px; color: #9c8e82;">Summary of all logged lost & found items and their current claim status</div>
        </div>

        <div class="row g-0 align-items-center">

            <!-- PIE CHART -->
            <div class="col-md-4 d-flex flex-column align-items-center justify-content-center" style="padding: 0.8rem;">
                <div style="position: relative; width: 160px; height: 160px;">
                    <canvas id="statsDonut"></canvas>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none;">
                        <div style="font-size: 1.7rem; font-weight: 800; color: #1e1b2e; line-height: 1;">@ViewBag.TotalItems</div>
                        <div style="font-size: 10px; font-weight: 600; color: #9c8e82; letter-spacing: 0.06em; text-transform: uppercase;">Total</div>
                    </div>
                </div>
            </div>

            <!-- DIVIDER -->
            <div class="col-md-1 d-none d-md-flex justify-content-center">
                <div style="width: 1px; height: 120px; background: #ece9f5;"></div>
            </div>

            <!-- STATS -->
            <div class="col-md-7 d-flex flex-column gap-2" style="padding: 0.8rem 1rem;">

                <!-- TOTAL -->
                <div style="display: flex; align-items: center; gap: 12px; background: #fdf9c4; border-radius: 12px; padding: 10px 14px;">
                    <div style="width: 34px; height: 34px; border-radius: 8px; background: #f0e800; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="bi bi-box-seam" style="color: #2a2a2a; font-size: 1rem;"></i>
                    </div>
                    <div>
                        <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.07em; color: #9c8e82; text-transform: uppercase;">Total Items</div>
                        <div style="font-size: 1.3rem; font-weight: 800; color: #1e1b2e; line-height: 1.2;">@ViewBag.TotalItems</div>
                    </div>
                </div>

                <!-- CLAIMED -->
                <div style="display: flex; align-items: center; gap: 12px; background: #eaf3de; border-radius: 12px; padding: 10px 14px;">
                    <div style="width: 34px; height: 34px; border-radius: 8px; background: #c0dd97; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="bi bi-check-circle" style="color: #2a2a2a; font-size: 1rem;"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.07em; color: #9c8e82; text-transform: uppercase;">Claimed</div>
                        <div style="display: flex; align-items: baseline; gap: 6px;">
                            <div style="font-size: 1.3rem; font-weight: 800; color: #1e1b2e; line-height: 1.2;">@ViewBag.ClaimedItems</div>
                            <div style="font-size: 11px; color: #4a7a1e; font-weight: 600;">
                                @(ViewBag.TotalItems > 0 ? $"{(ViewBag.ClaimedItems * 100) / ViewBag.TotalItems}%" : "0%")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- UNCLAIMED -->
                <div style="display: flex; align-items: center; gap: 12px; background: #fde8f1; border-radius: 12px; padding: 10px 14px;">
                    <div style="width: 34px; height: 34px; border-radius: 8px; background: #f4c0d1; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="bi bi-hourglass-split" style="color: #2a2a2a; font-size: 1rem;"></i>
                    </div>
                    <div style="flex: 1;">
                        <div style="font-size: 10px; font-weight: 600; letter-spacing: 0.07em; color: #9c8e82; text-transform: uppercase;">Unclaimed</div>
                        <div style="display: flex; align-items: baseline; gap: 6px;">
                            <div style="font-size: 1.3rem; font-weight: 800; color: #1e1b2e; line-height: 1.2;">@ViewBag.UnclaimedItems</div>
                            <div style="font-size: 11px; color: #c85a88; font-weight: 600;">
                                @(ViewBag.TotalItems > 0 ? $"{(ViewBag.UnclaimedItems * 100) / ViewBag.TotalItems}%" : "0%")
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <!-- RECENT ITEMS + CLAIMS -->
    <div class="row mt-4">

        <!-- RECENT ITEMS -->
        <div class="col-md-6">
            <div class="card-dark">
                <p>LOST VS CLAIMED - MONTHLY</p>
                <div class="table-responsive">
                    <div style="height:300px;">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT CLAIMS -->
        <div class="col-md-6">
            <div class="card-dark">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        @* <h6 class="fw-bold mb-1"
                            style="font-family:'Plus Jakarta Sans', sans-serif; color:#1e1e1e;">
                            Category Overview
                        </h6> *@

                        <small style="color:#9c8e82; font-family:'Spline Sans Mono', monospace;">
                            Distribution of found items
                        </small>
                    </div>
                </div>

                @{
                    var total = 0;

                    foreach (var row in ViewBag.CategoryStats)
                    {
                        total += row.Count;
                    }
                }

                @if (total == 0)
                {
                    <div class="empty-state">No items to chart yet.</div>
                }
                else
                {
                <div class="d-flex flex-column gap-4">

                    @foreach (var row in ViewBag.CategoryStats)
                    {
                        var percent = total > 0
                            ? (row.Count * 100) / total
                            : 0;

                        <div>

                            <!-- LABEL -->
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <div class="d-flex align-items-center gap-2">
                                    <div style="
                                    width:10px;
                                    height:10px;
                                    border-radius:50%;
                                    background:@(colors.ContainsKey(row.Category) ? colors[row.Category] : "#1e1e1e");
                                    "></div>

                                    <span style="
                                        font-family:'Spline Sans Mono', monospace;
                                        font-size:14px;
                                        font-weight:500;
                                        color:#5c524a;
                                        ">
                                        @row.Category
                                    </span>
                                </div>

                                <span style="
                                    font-size:12px;
                                    color:#9c8e82;
                                    font-family:'Spline Sans Mono', monospace;
                                    ">
                                    @row.Count items
                                </span>

                            </div>

                            <!-- BAR -->
                            <div style="
                                width:100%;
                                height:10px;
                                background:#efe9df;
                                border-radius:999px;
                                overflow:hidden;
                                ">

                                <div style="
                                width:@percent%;
                                height:100%;
                                background:@(colors.ContainsKey(row.Category) ? colors[row.Category] : "#1e1e1e");
                                border-radius:999px;
                                transition:0.4s ease;
                                "></div>

                            </div>

                        </div>
                    }

                </div>
                }

            </div>
        </div>

    </div>

    <div class="card-dark mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="fw-bold mb-1"
                    style="font-family:'Plus Jakarta Sans', sans-serif; color:#1e1e1e;">
                    Recent Items
                </h6>

                <small style="color:#9c8e82; font-family:'Spline Sans Mono', monospace;">
                    Latest reported items in the system
                </small>
            </div>

            <a href="/ManageItems/Index"
                   class="btn btn-sm rounded-4 px-3"
                   style="background:#1e1e1e; color:white;">
                View All
            </a>
        </div>

        @{
            var hasRecentItems = false;
            foreach (var _ in ViewBag.RecentItems)
            {
                hasRecentItems = true;
                break;
            }
        }

        @if (!hasRecentItems)
        {
            <div class="empty-state">No recent items yet.</div>
        }
        else
        {
        <div class="table-responsive">
        <table class="table table-borderless finder-table align-middle mt-3">
            <thead>
                <tr>
                    <th>ITEM</th>
                    <th>CATEGORY</th>
                    <th>LOCATION</th>
                    <th>DATE FOUND</th>
                    <th>STATUS</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in ViewBag.RecentItems)
                {
                    <tr>

                        <!-- ITEM -->
                        <td>
                            <div class="d-flex align-items-center gap-3">

                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    var normalizedPath = item.ImagePath.Replace('\\', '/');
                                    var uploadsIndex = normalizedPath.IndexOf("/uploads/", StringComparison.OrdinalIgnoreCase);
                                    var imagePath = uploadsIndex >= 0
                                        ? normalizedPath.Substring(uploadsIndex)
                                        : normalizedPath.StartsWith("/", StringComparison.Ordinal)
                                            ? normalizedPath
                                            : $"/uploads/{normalizedPath.TrimStart('/')}";
                                    <img src="@Url.Content($"~/{imagePath.TrimStart('/')}")"
                                         alt="@item.ItemName"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                         style="
                                    width:42px;
                                    height:42px;
                                    border-radius:10px;
                                    object-fit:cover;
                                    background:#f3f3f3;
                                    " />
                                    <div style="
                                        width:42px;
                                        height:42px;
                                        border-radius:10px;
                                        background:#f0ebe3;
                                        display:none;
                                        align-items:center;
                                        justify-content:center;
                                        color:#9c8e82;
                                        ">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                else
                                {
                                    <div style="
                                        width:42px;
                                        height:42px;
                                        border-radius:10px;
                                        background:#f0ebe3;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                        color:#9c8e82;
                                        ">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <div>
                                    <div style="
                                        font-weight:600;
                                        color:#1e1e1e;
                                        font-size:14px;
                                        ">
                                        @item.ItemName
                                    </div>

                                    <div style="
                                        font-size:12px;
                                        color:#9c8e82;
                                        max-width:220px;
                                        white-space:nowrap;
                                        overflow:hidden;
                                        text-overflow:ellipsis;
                                        ">
                                        @item.Description
                                    </div>
                                </div>

                            </div>
                        </td>

                        <!-- CATEGORY -->
                        <td>
                            <span style="
                                background:#f3efe8;
                                color:#5C524A;
                                padding:5px 10px;
                                border-radius:20px;
                                font-size:11px;
                                font-weight:600;
                                ">
                                @item.Category
                            </span>
                        </td>

                        <!-- LOCATION -->
                        <td>@item.LocationFound</td>

                        <!-- DATE -->
                        <td>@item.DateFound.ToString("MMM d, yyyy")</td>

                                <!-- STATUS -->
                                <td>
                                    @if (item.DisplayStatus == "claimed")
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 6px; background: #eaf3de; color: #3b6d11; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px;">
                                            <span style="width: 7px; height: 7px; border-radius: 50%; background: #4a7a1e; flex-shrink: 0;"></span>
                                            Claimed
                                        </span>
                                    }
                                    else if (item.DisplayStatus == "pending")
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 6px; background: #fdf9c4; color: #7a6300; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px;">
                                            <span style="width: 7px; height: 7px; border-radius: 50%; background: #c4b800; flex-shrink: 0;"></span>
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="display: inline-flex; align-items: center; gap: 6px; background: #fde8f1; color: #993556; font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px;">
                                            <span style="width: 7px; height: 7px; border-radius: 50%; background: #c85a88; flex-shrink: 0;"></span>
                                            Unclaimed
                                        </span>
                                    }
                                </td>

                    </tr>
                }
            </tbody>
        </table>
        </div>
        }

    </div>

</div>

@section Scripts{
    <script>
        const monthlyLabels = [
            @foreach (var row in ViewBag.MonthlyStats)
            {
                            @Html.Raw($"'{row.Label}',")
            }
        ];

        const lostData = [
            @foreach (var row in ViewBag.MonthlyStats)
            {
                            @($"{row.Lost},")
            }
        ];

        const claimedData = [
            @foreach (var row in ViewBag.MonthlyStats)
            {
                            @($"{row.Claimed},")
            }
        ];

        const ctx = document.getElementById('monthlyChart');

        new Chart(ctx, {
            type: 'line',

            data: {
                labels: monthlyLabels,

                datasets: [
                    {
                        label: 'Lost',
                        data: lostData,
                        tension: 0.4,
                        borderWidth: 3,
                        fill: false,
                        borderColor: '#c85a88',
                        backgroundColor: '#c85a88'
                    },
                    {
                        label: 'Claimed',
                        data: claimedData,
                        tension: 0.4,
                        borderWidth: 3,
                        fill: false,
                        borderColor: '#4a7a1e',
                        backgroundColor: '#4a7a1e'
                    }
                ]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        labels: {
                            color: '#5C524A',
                            font: {
                                family: 'Spline Sans Mono'
                            }
                        }
                    }
                },

                scales: {
                    x: {
                        ticks: {
                            color: '#9c8e82'
                        },
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            color: '#9c8e82',
                            stepSize: 1
                        },

                        grid: {
                            color: '#f1ece5'
                        }
                    }
                }
            }
        });

               const donutCtx = document.getElementById('statsDonut');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Claimed', 'Unclaimed'],
                datasets: [{
                    data: [@ViewBag.ClaimedItems, @ViewBag.UnclaimedItems],
                    backgroundColor: ['#4a7a1e', '#c85a88'],
                    borderColor: ['#4a7a1e', '#c85a88'],
                    borderWidth: 0,
                    hoverOffset: 8,
                    borderRadius: 6,
                    spacing: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                rotation: -90,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e1b2e',
                        padding: 10,
                        cornerRadius: 10,
                        titleFont: { family: 'Spline Sans Mono', size: 11 },
                        bodyFont: { family: 'Spline Sans Mono', size: 13, weight: '700' },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? Math.round((context.parsed / total) * 100) : 0;
                                return ` ${context.parsed} items — ${pct}%`;
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    animateScale: true,
                    duration: 900,
                    easing: 'easeInOutQuart'
                }
            }
        });
    </script>
}