    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<FinderLink.Models.Item>
@{
}
<style>
    /* ===== PANELS ===== */
    .card-dark {
        background: #FFFEFC;
        border-radius: 14px;
        padding: 20px;
        border: 1px solid #ece9f5;
    }

        .card-dark p {
            font-size: 0.8rem;
            font-weight: 500;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid #eee;
            font-family: 'Spline Sans Mono', monospace;
            color: #9c8e82;
        }

    /* ===== TABLE ===== */
    .table {
        background: transparent !important;
        color: #1e1b2e;
        
    }

    tr{
        /* border-bottom: 1px solid rgba(92, 82, 74, 0.6) */
    }

        .table th {
            font-size: 12px;
            color: rgba(92, 82, 74, 0.8);
            font-family: 'Spline Sans Mono', monospace;
        }

        .table td {
            font-size: 14px;
            border-top: 1px solid #eee;
        }

    /* ROW HOVER */
    .table tbody tr {
        transition: 0.2s ease;
    }

        .table tbody tr:hover {
            background: rgba(0, 0, 0, 0.03);
        }

    /* ITEM CELL */
    .item-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .item-img {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #f3f3f3;
    }

    .item-name {
        font-weight: 600;
        font-size: 14px;
        color: #1e1b2e;
    }

    .item-desc {
        font-size: 12px;
        color: #9c8e82;
    }

    /* STATUS BADGE */
    .status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

        .status.unclaimed {
            background: rgba(255, 193, 7, 0.15);
            color: #b88900;
        }

        .status.claimed {
            background: rgba(40, 167, 69, 0.15);
            color: #2e7d32;
        }

    /* ACTION BUTTON */
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        cursor: pointer;
    }

        .action-btn:hover {
            background: rgba(0,0,0,0.05);
        }

    /* DROPDOWN MENU */
    .action-menu {
        border-radius: 10px;
        border: 1px solid #eee;
        padding: 6px;
        min-width: 140px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        /* ITEMS */
        .action-menu .dropdown-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            border-radius: 8px;
            padding: 6px 10px;
            transition: 0.2s;
        }

            /* HOVER */
            .action-menu .dropdown-item:hover {
                background: rgba(0,0,0,0.04);
            }

        /* ICON */
        .action-menu i {
            font-size: 13px;
            opacity: 0.7;
        }

</style>
<div class="page">
    <div class="page-header">
        <h1>Manage Items</h1>
        <p>View and manage all lost and found items</p>
    </div>

    <div class="card-dark mt-4">

        <form class="row g-2 align-items-end mb-4" method="get">
            <div class="col-12 col-lg-6">
                <div class="position-relative" style="width: 100%;">
                    <i class="bi bi-search position-absolute" style="top: 0.55rem; left: 0.8rem"></i>
                    <input name="search" value="@ViewBag.Search" placeholder="Search items..." style="width: 100%; border-radius: 20px; padding-left: 2.3rem;" />
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <select class="rounded-4 px-3 w-100" name="category">
                    <option value="">All Categories</option>
                    @foreach (var c in (string[])ViewBag.Categories)
                    {
                        if ((string?)ViewBag.SelectedCategory == c)
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <select class="rounded-4 px-3 w-100" name="location">
                    <option value="">All Locations</option>
                    @foreach (var l in (string[])ViewBag.Locations)
                    {
                        if ((string?)ViewBag.SelectedLocation == l)
                        {
                            <option value="@l" selected>@l</option>
                        }
                        else
                        {
                            <option value="@l">@l</option>
                        }
                    }
                </select>
            </div>

            <div class="col-12">
                <button class="btn btn-dark rounded-4 px-3" type="submit">Apply</button>
            </div>
        </form>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">No items found.</div>
        }
        else
        {
        <div class="table-responsive">
        <table class="table table-borderless finder-table mt-3">
            <thead>
                <tr>
                    <th>ITEM</th>
                    <th>CATEGORY</th>
                    <th>LOCATION</th>
                    <th>DATE FOUND</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    <td class="item-cell">
                        <div class="item-wrap">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img class="item-img"
                                         src="@item.ImagePath"
                                         alt="@item.ItemName"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <div class="item-img d-none align-items-center justify-content-center"
                                         style="display:none; background:#f0ebe3; color:#9c8e82;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="item-img d-flex align-items-center justify-content-center"
                                         style="background:#f0ebe3; color:#9c8e82;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            <div>
                                <div class="item-name">@item.ItemName</div>
                                <div class="item-desc">@item.Description</div>
                            </div>
                        </div>
                    </td>
                    
                    <td>@item.Category</td>
                    <td>@item.LocationFound</td>
                    <td>@item.DateFound.ToString("MMM d, yyyy")</td>

                    <td>
                        <span class="status @item.Status">@item.Status</span>
                    </td>

                    <td>
                        <div class="dropdown">
                            <div class="action-btn" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end action-menu">
                                <li>
                                    <a class="dropdown-item view-item"
                                           href="#"
                                           data-bs-toggle="modal"
                                           data-bs-target="#viewItemModal"
                                           data-name="@item.ItemName"
                                           data-desc="@item.Description"
                                           data-category="@item.Category"
                                           data-location="@item.LocationFound"
                                           data-date="@item.DateFound.ToString("MMM d, yyyy")">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </li>
                                <li>
                                        <a class="dropdown-item text-danger delete-item"
                                            href="#"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteItemModal"
                                            data-id="@item.ItemId"
                                            data-name="@item.ItemName">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                </li>
                                    <li>
                                        <a class="dropdown-item edit-item"
                                               href="#"
                                               data-bs-toggle="modal"
                                               data-bs-target="#editItemModal"
                                               data-id="@item.ItemId"
                                               data-name="@item.ItemName"
                                               data-desc="@item.Description"
                                               data-category="@item.Category"
                                               data-location="@item.LocationFound"
                                               data-status="@item.Status"
                                               data-image="@item.ImagePath">

                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                    </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                }
                @* @foreach (var item in ViewBag.RecentItems)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Station</td>
                                <td>@item.DateFound</td>
                            </tr>
                        } *@


            </tbody>
        </table>
    </div>
        }
</div>

@section Scripts {
    <script>
        document.addEventListener("click", function (e) {
            var trigger = e.target.closest(".view-item");
            if (!trigger) return;
            document.getElementById("v-name").textContent = trigger.dataset.name || "";
            document.getElementById("v-desc").textContent = trigger.dataset.desc || "";
            document.getElementById("v-category").textContent = trigger.dataset.category || "";
            document.getElementById("v-location").textContent = trigger.dataset.location || "";
            document.getElementById("v-date").textContent = trigger.dataset.date || "";
        });
    </script>

    <script>
        document.addEventListener("click", function (e) {

            // ======================
            // VIEW MODAL
            // ======================
            const viewTrigger = e.target.closest(".view-item");
            if (viewTrigger) {
                document.getElementById("v-name").textContent = viewTrigger.dataset.name || "";
                document.getElementById("v-desc").textContent = viewTrigger.dataset.desc || "";
                document.getElementById("v-category").textContent = viewTrigger.dataset.category || "";
                document.getElementById("v-location").textContent = viewTrigger.dataset.location || "";
                document.getElementById("v-date").textContent = viewTrigger.dataset.date || "";
            }

            // ======================
            // EDIT MODAL
            // ======================
            const editTrigger = e.target.closest(".edit-item");
            if (editTrigger) {
                document.getElementById("removeImageFlag").value = "false";
                document.getElementById("editItemId").value =
                    editTrigger.dataset.id || "";

                document.getElementById("editName").value =
                    editTrigger.dataset.name || "";

                document.getElementById("editDesc").value =
                    editTrigger.dataset.desc || "";

               document.getElementById("editCategory").value =
                    editTrigger.dataset.category || "";

                document.getElementById("editLocation").value =
                    editTrigger.dataset.location || "";

                // ===== IMAGE PREVIEW =====
                const img = editTrigger.dataset.image;
                const preview = document.getElementById("editImagePreview");

                if (img) {
                    preview.src = img;
                    preview.style.display = "block";
                } else {
                    preview.style.display = "none";
                }
            }

            // ======================
            // DELETE MODAL
            // ======================
            const deleteTrigger = e.target.closest(".delete-item");

            if (deleteTrigger) {

                document.getElementById("deleteItemId").value =
                    deleteTrigger.dataset.id || "";

                document.getElementById("deleteItemName").textContent =
                    deleteTrigger.dataset.name || "this item";
            }

            });

            document.getElementById("removeImageBtn").addEventListener("click", function () {

            const preview = document.getElementById("editImagePreview");
            const fileInput = document.getElementById("editImageFile");
            const flag = document.getElementById("removeImageFlag");

            // clear preview
            preview.src = "";
            preview.style.display = "none";

            // clear file input
            fileInput.value = "";

            // mark for backend
            flag.value = "true";
        });
    </script>
}

<div class="modal fade" id="viewItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">

            <div class="modal-body p-4">

                <h5 class="fw-bold mb-3">Item Details</h5>

                <div class="mb-3">
                    <small class="text-muted">Item Name</small>
                    <div id="v-name" class="fw-semibold"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Description</small>
                    <div id="v-desc"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Category</small>
                    <div id="v-category"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Location</small>
                    <div id="v-location"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Date Found</small>
                    <div id="v-date"></div>
                </div>

                <div class="text-end mt-4">
                    <button class="btn btn-dark px-4" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- EDIT MODAL -->

<div class="modal fade" id="editItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content finder-modal">

            <div class="modal-body p-4">

                <h5 class="mb-1">Edit Item</h5>

                <p class="text-muted mb-4" style="font-size: 13px;">
                    Update item details below.
                </p>

                <form method="post"
                      asp-action="Edit"
                      asp-controller="ManageItems"
                      enctype="multipart/form-data"
                      class="d-flex flex-column gap-3">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editItemId" name="ItemId" />

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label mb-0">ITEM IMAGE</label>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                id="removeImageBtn">
                            <i class="bi bi-trash"></i> Remove
                        </button>
                    </div>

                    <img id="editImagePreview"
                         style="width:100%;
                    max-height:200px;
                    object-fit:cover;
                    border-radius:10px;
                    margin-bottom:10px;
                    display:none;" />

                    <input type="hidden" id="removeImageFlag" name="RemoveImage" value="false" />

                    <input type="file"
                           class="form-control custom-input"
                           id="editImageFile"
                           name="ImageFile"
                           accept="image/*" />
                    <div>
                        <label class="form-label">ITEM NAME</label>
                        <input id="editName" name="ItemName" class="form-control custom-input" />
                    </div>

                    <div>
                        <label class="form-label">DESCRIPTION</label>
                        <textarea id="editDesc" name="Description"
                                  class="form-control custom-input"
                                  rows="3"></textarea>
                    </div>

                    <div class="row g-2">

                        <!-- CATEGORY -->
                        <div class="col-md-6">
                            <label class="form-label">CATEGORY</label>
                            <select id="editCategory"
                                    name="Category"
                                    class="form-control custom-input">
                                @foreach (var c in (string[])ViewBag.Categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>

                        <!-- LOCATION -->
                        <div class="col-md-6">
                            <label class="form-label">LOCATION</label>
                            <select id="editLocation"
                                    name="LocationFound"
                                    class="form-control custom-input">
                                @foreach (var l in (string[])ViewBag.Locations)
                                {
                                    <option value="@l">@l</option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn-submit">
                            Save Changes →
                        </button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>


<!-- DELETE MODAL -->

<div class="modal fade" id="deleteItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content finder-modal">

            <div class="modal-body p-4 text-center">

                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill"
                       style="font-size: 2rem; color:#b88900;"></i>
                </div>

                <h5 class="fw-bold mb-2">Delete Item?</h5>

                <p class="text-muted mb-4" style="font-size: 13px;">
                    Are you sure you want to delete <span id="deleteItemName" class="fw-semibold"></span>?<br />
                    This action cannot be undone.
                </p>

                <form method="post"
                      asp-controller="ManageItems"
                      asp-action="Delete">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteItemId" name="id" />

                    <div class="d-flex justify-content-center gap-2">

                        <button type="button"
                                class="btn-cancel"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn-submit"
                                style="background:#b91c1c;">
                            Yes, Delete
                        </button>

                    </div>
                </form>

            </div>

        </div>
    </div>
</div>