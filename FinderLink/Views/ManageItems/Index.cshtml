*@
@model List<FinderLink.Models.Item>
@{
}
<style>
    /* ===== PANELS ===== */
    .card-dark {
        background: #FFFEFC;
        border-radius: 14px;
        padding: 20px;
        border: 1px solid #ece9f5;
    }

        .card-dark p {
            font-size: 0.8rem;
            font-weight: 500;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid #eee;
            font-family: 'Spline Sans Mono', monospace;
            color: #9c8e82;
        }

    /* ===== TABLE ===== */
    .table {
        background: transparent !important;
        color: #1e1b2e;
        
    }

    tr{
        /* border-bottom: 1px solid rgba(92, 82, 74, 0.6) */
    }

        .table th {
            font-size: 12px;
            color: rgba(92, 82, 74, 0.8);
            font-family: 'Spline Sans Mono', monospace;
        }

        .table td {
            font-size: 14px;
            border-top: 1px solid #eee;
        }

    /* ROW HOVER */
    .table tbody tr {
        transition: 0.2s ease;
    }

        .table tbody tr:hover {
            background: rgba(0, 0, 0, 0.03);
        }

    /* ITEM CELL */
    .item-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .item-img {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #f3f3f3;
    }

    .item-name {
        font-weight: 600;
        font-size: 14px;
        color: #1e1b2e;
    }

    .item-desc {
        font-size: 12px;
        color: #9c8e82;
    }

    /* STATUS BADGE */
    .status {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

        .status.unclaimed {
            background: rgba(255, 193, 7, 0.15);
            color: #b88900;
        }

        .status.claimed {
            background: rgba(40, 167, 69, 0.15);
            color: #2e7d32;
        }

    /* ACTION BUTTON */
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        cursor: pointer;
    }

        .action-btn:hover {
            background: rgba(0,0,0,0.05);
        }

    /* DROPDOWN MENU */
    .action-menu {
        border-radius: 10px;
        border: 1px solid #eee;
        padding: 6px;
        min-width: 140px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        /* ITEMS */
        .action-menu .dropdown-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            border-radius: 8px;
            padding: 6px 10px;
            transition: 0.2s;
        }

            /* HOVER */
            .action-menu .dropdown-item:hover {
                background: rgba(0,0,0,0.04);
            }

        /* ICON */
        .action-menu i {
            font-size: 13px;
            opacity: 0.7;
        }

</style>
<div class="page">
    <div class="page-header">
        <h1>Manage Items</h1>
        <p>View and manage all lost and found items</p>
    </div>

    <div class="card-dark mt-4 pb-5S">
       
        <form class="d-flex gap-3 align-items-center mb-5" method="get">
            <div class="position-relative mr-4" style="width: 100%; max-width: 500px;">
                <i class="bi bi-search position-absolute" style="top: 0.4rem; left: 0.7rem"></i>
                <input name="search" value="@ViewBag.Search" placeholder="Search items..." style="width: 100%; border-radius: 20px; padding-left: 2.3rem;" />
            </div>

            <select class="rounded-4 px-3" name="category">
                <option value="">All Categories</option>
                @foreach (var c in (string[])ViewBag.Categories)
                {
                    if ((string?)ViewBag.SelectedCategory == c)
                    {
                        <option value="@c" selected>@c</option>
                    }
                    else
                    {
                        <option value="@c">@c</option>
                    }
                }
            </select>

            <select class="rounded-4 px-3" name="location">
                <option value="">All Locations</option>
                @foreach (var l in (string[])ViewBag.Locations)
                {
                    if ((string?)ViewBag.SelectedLocation == l)
                    {
                        <option value="@l" selected>@l</option>
                    }
                    else
                    {
                        <option value="@l">@l</option>
                    }
                }
            </select>
            <button class="btn btn-dark rounded-4 px-3" type="submit">Apply</button>
        </form>

        <table class="table table-borderless mt-3">
            <thead>
                <tr>
                    <th>ITEM</th>
                    <th>CATEGORY</th>
                    <th>LOCATION</th>
                    <th>DATE FOUND</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    <td class="item-cell">
                        <div class="item-wrap">
                            <img class="item-img" src="@item.ImagePath" />
                            <div>
                                <div class="item-name">@item.ItemName</div>
                                <div class="item-desc">@item.Description</div>
                            </div>
                        </div>
                    </td>
                    
                    <td>@item.Category</td>
                    <td>@item.LocationFound</td>
                    <td>@item.DateFound.ToString("MMM d, yyyy")</td>

                    <td>
                        <span class="status @item.Status">@item.Status</span>
                    </td>

                    <td>
                        <div class="dropdown">
                            <div class="action-btn" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end action-menu">
                                <li>
                                    <a class="dropdown-item view-item"
                                           href="#"
                                           data-bs-toggle="modal"
                                           data-bs-target="#viewItemModal"
                                           data-name="@item.ItemName"
                                           data-desc="@item.Description"
                                           data-category="@item.Category"
                                           data-location="@item.LocationFound"
                                           data-date="@item.DateFound.ToString("MMM d, yyyy")">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </li>
                                <li>
                                    <form method="post" asp-controller="ManageItems" asp-action="Delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ItemId" />
                                        <button class="dropdown-item text-danger" type="submit">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                }
                @* @foreach (var item in ViewBag.RecentItems)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Station</td>
                                <td>@item.DateFound</td>
                            </tr>
                        } *@


            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("click", function (e) {
            var trigger = e.target.closest(".view-item");
            if (!trigger) return;
            document.getElementById("v-name").textContent = trigger.dataset.name || "";
            document.getElementById("v-desc").textContent = trigger.dataset.desc || "";
            document.getElementById("v-category").textContent = trigger.dataset.category || "";
            document.getElementById("v-location").textContent = trigger.dataset.location || "";
            document.getElementById("v-date").textContent = trigger.dataset.date || "";
        });
    </script>
}

<div class="modal fade" id="viewItemModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">

            <div class="modal-body p-4">

                <h5 class="fw-bold mb-3">Item Details</h5>

                <div class="mb-3">
                    <small class="text-muted">Item Name</small>
                    <div id="v-name" class="fw-semibold"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Description</small>
                    <div id="v-desc"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Category</small>
                    <div id="v-category"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Location</small>
                    <div id="v-location"></div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Date Found</small>
                    <div id="v-date"></div>
                </div>

                <div class="text-end mt-4">
                    <button class="btn btn-dark px-4" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>
