@model List<FinderLink.Models.Item>
@{
    ViewBag.Title = "FinderLink";
    ViewData["HideSideBar"] = true;
}

<style>
    /* HEADER */
    .header-bar {
        padding: 0.6rem 1.2rem;
        border-bottom: 1px solid rgba(92, 82, 74, 0.25);
        background-color: #F5F0E8;
    }

    /* BRAND */
    .brand-icon-wrap {
        width: 40px;
        height: 40px;
        background-color: #2a2a2a;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .brand-icon-wrap i {
            font-size: 1.4rem;
            color: white;
        }

    /* TITLE */
    .brand-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2a2a2a;
    }

    /* BUTTON */
    .admin-btn {
        background: #2a2a2a;
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
    }

        .admin-btn i {
            font-size: 0.9rem;
            transition: transform 0.2s;
        }

        .admin-btn:hover i {
            transform: translateX(3px);
        }

    /* SEARCH SECTION */
    .search-div {
        min-height: 220px;
        background: #2a2a2a;
        border-radius: 28px;
        padding: 2.2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .search-div p {
            font-family: 'Spline Sans Mono', monospace;
            color: #e8d84f;
            font-size: 11px;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .search-div h3 {
            font-size: 2rem;
            margin-bottom: 1.4rem;
        }

    /* SEARCH ROW */
    .search-row {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    /* INPUT */
    .search-bar {
        flex: 1;
        min-width: 220px;
        border: none;
        outline: none;
        border-radius: 28px;
        padding: 0.9rem 1.2rem;
        background: rgba(245, 240, 232, 0.16);
        color: white;
        font-size: 14px;
    }

        .search-bar::placeholder {
            color: rgba(255,255,255,0.5);
        }

        .search-bar:focus,
        .filter-select:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(232, 216, 79, 0.6);
            background: rgba(245, 240, 232, 0.22);
        }

    /* SELECTS */
    .filter-select {
        border: none;
        outline: none;
        border-radius: 20px;
        padding: 0.7rem 1rem;
        font-size: 13px;
        background: rgba(245, 240, 232, 0.16);
        color: white;
        min-width: 160px;
        cursor: pointer;
    }

        .filter-select option {
            color: black;
        }

    /* PAGE BACKGROUND */
    .page-bg {
        background-color: #f0ebe3;
        min-height: 100vh;
        width: 100%;
    }

    /* RESULTS META */
    .results-meta {
        font-size: 13px;
        color: #7a7060;
    }

    /* ITEM CARD */
    .item-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
    }

        .item-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }

    /* CARD IMAGE */
    .item-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background-color: #e8e2d9;
        display: block;
    }

    /* IMAGE PLACEHOLDER (broken img fallback) */
    .item-card-img-placeholder {
        width: 100%;
        height: 200px;
        background-color: #e8e2d9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 2rem;
    }

    /* CARD BODY */
    .item-card-body {
        padding: 1.1rem 1.2rem 1.3rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* CARD TITLE ROW */
    .item-card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 0.5rem;
    }

    .item-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    /* CATEGORY BADGE */
    .category-badge {
        background: #ede8e0;
        color: #5a5040;
        font-size: 11px;
        font-weight: 600;
        border-radius: 20px;
        padding: 3px 10px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* CARD DESCRIPTION */
    .item-card-desc {
        font-size: 13px;
        color: #6b6356;
        line-height: 1.5;
        margin-bottom: 0.8rem;
        flex: 1;
    }

    /* CARD META (location + date) */
    .item-card-meta {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 1rem;
        font-size: 12px;
        color: #9a8f82;
    }

        .item-card-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

    /* CLAIM BUTTON */
    .claim-btn {
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 30px;
        padding: 0.7rem 1rem;
        font-size: 14px;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        transition: background 0.2s;
    }

        .claim-btn:hover {
            background: #333;
        }

    /* MODAL STYLING*/

    .claim-modal {
        border-radius: 18px;
        border: none;
        padding: 4px;
    }

    /* INPUTS */
    .custom-input {
        border-radius: 10px;
        border: 1px solid #e5e1dc;
        font-size: 14px;
        padding: 0.6rem 0.8rem;
    }

        .custom-input:focus {
            border-color: #e8d84f;
            box-shadow: 0 0 0 2px rgba(232, 216, 79, 0.25);
        }

    /* BUTTONS */
    .btn-cancel {
        background: transparent;
        border: none;
        font-size: 13px;
        font-weight: 600;
        color: #5C524A;
        padding: 6px 12px;
    }

    .btn-submit {
        background: #2a2a2a;
        color: white;
        border: none;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-submit:hover {
            background: #1f1f1f;
        }

    label{
        font-size: 12px;
    }
</style>

<div class="page-bg">

    <!-- HEADER -->
    <div class="header-bar d-flex justify-content-between align-items-center ">
        <div class="d-flex gap-2 align-items-center">
            <div class="brand-icon-wrap">
                <i class="bi bi-geo-alt"></i>
            </div>
            <div class="brand-title">FinderLink</div>
        </div>
        <a href="/login/index" class="admin-btn">
            Admin Portal
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="p-4">

        <!-- SEARCH SECTION -->
        <div class="search-div mb-4">
            <p>LOST SOMETHING?</p>
            <h3 class="fw-bold text-light">Search found items</h3>
            <form method="get" class="search-row">
                <input class="search-bar" name="search" value="@ViewBag.Search" placeholder="Search items..." />
                <select class="filter-select" name="category">
                    <option value="">ALL CATEGORIES</option>
                    @foreach (var c in (string[])ViewBag.Categories)
                    {
                        if ((string?)ViewBag.SelectedCategory == c)
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
                <select class="filter-select" name="location">
                    <option value="">ALL LOCATION</option>
                    @foreach (var l in (string[])ViewBag.Locations)
                    {
                        if ((string?)ViewBag.SelectedLocation == l)
                        {
                            <option value="@l" selected>@l</option>
                        }
                        else
                        {
                            <option value="@l">@l</option>
                        }
                    }
                </select>
                <button class="btn-submit" type="submit">Apply</button>
            </form>
        </div>

        <!-- RESULTS META -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="results-meta">Showing @Model.Count of @ViewBag.TotalUnclaimed unclaimed items</span>
            <span class="results-meta">Sorted by newest</span>
        </div>

        <!-- CARDS GRID -->
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="item-card h-100">

                        <!-- IMAGE -->
                        
                            <img src="@item.ImagePath"
                                 class="item-card-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="item-card-img-placeholder" style="display:none;">
                                <i class="bi bi-image"></i>
                            </div>
                      
                        @*     <div class="item-card-img-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                         *@

                        <!-- BODY -->
                        <div class="item-card-body">

                            <!-- TITLE + BADGE -->
                            <div class="item-card-title-row">
                                <h6 class="item-card-title">@item.ItemName</h6>
                                <span class="category-badge">@item.Category</span>
                            </div>

                            <!-- DESCRIPTION -->
                            <p class="item-card-desc">@item.Description</p>

                            <!-- LOCATION + DATE -->
                            <div class="item-card-meta">
                                <span>
                                    <i class="bi bi-geo-alt"></i>
                                    @item.LocationFound
                                </span>
                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @item.DateFound.ToString("MMM d, yyyy")
                                </span>
                            </div>

                            <!-- CLAIM BUTTON -->
                        <button class="claim-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#claimModal"
                                data-item-id="@item.ItemId"
                                data-item-image="@item.ImagePath">
                            Claim this item
                        </button>

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

<!-- CLAIM MODAL -->
<div class="modal fade" id="claimModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content claim-modal">

            <div class="modal-body p-4">

                <!-- TITLE -->
                <h5 class="fw-bold mb-1">Claim this item</h5>
                <img id="claimModalImage" src="" alt="Item photo" style="width:100%; max-height:220px; object-fit:cover; border-radius:10px; margin-bottom:12px; display:none;" />
                <p class="text-muted mb-4" style="font-size: 13px;">
                    Provide your contact info and proof of ownership for verification.
                </p>

                <!-- FORM -->
                <form class="d-flex flex-column gap-3" method="post" asp-controller="Public" asp-action="Claim">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="claimItemId" name="ItemId" />

                    <div>
                        <label class="form-label">FULL NAME *</label>
                        <input class="form-control custom-input" name="FullName" placeholder="Your full name" />
                    </div>

                    <div>
                        <label class="form-label">CONTACT INFO *</label>
                        <input class="form-control custom-input" name="ContactInfo" placeholder="+63 9XX XXX XXXX" />
                    </div>

                    <div>
                        <label class="form-label">PROOF OF OWNERSHIP</label>
                        <textarea class="form-control custom-input" name="ProofOfOwnership" rows="3"
                                  placeholder="Describe unique identifying details about this item..."></textarea>
                    </div>

                    <!-- ACTIONS -->
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn-cancel" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn-submit">
                            Submit Claim →
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("click", function (e) {
            var button = e.target.closest(".claim-btn");
            if (!button) return;
            var itemIdInput = document.getElementById("claimItemId");
            var itemImage = document.getElementById("claimModalImage");
            if (itemIdInput) {
                itemIdInput.value = button.getAttribute("data-item-id");
            }
            if (itemImage) {
                var imagePath = button.getAttribute("data-item-image");
                itemImage.src = imagePath || "";
                itemImage.style.display = imagePath ? "block" : "none";
            }
        });
    </script>
}
