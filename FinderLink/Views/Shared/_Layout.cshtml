<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinderLink</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinderLink.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="w-100 p-0 m-0 min-vh-100 d-flex flex-column">
        <main role="main" class="app-shell flex-grow-1">

            @if (ViewData["HideSideBar"] as bool? ?? false)
            {
                <div class="app-content app-content--full">
                    @if (TempData["Success"] != null)
                    {
                        <div class="flash-wrap">
                            <div class="alert alert-success mb-0" role="alert">@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="flash-wrap">
                            <div class="alert alert-danger mb-0" role="alert">@TempData["Error"]</div>
                        </div>
                    }
                    @RenderBody()
                </div>
            }
            else
            {
                <partial name="_Sidebar" />
                <div class="app-content d-flex flex-column flex-grow-1">
                    @if (TempData["Success"] != null)
                    {
                        <div class="flash-wrap">
                            <div class="alert alert-success mb-0" role="alert">@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="flash-wrap">
                            <div class="alert alert-danger mb-0" role="alert">@TempData["Error"]</div>
                        </div>
                    }
                    @RenderBody()
                </div>
            }

        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
