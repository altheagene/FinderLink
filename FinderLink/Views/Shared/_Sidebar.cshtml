@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var username = Context.Session.GetString("AdminUsername");
    var name = Context.Session.GetString("AdminName");
    var initials = string.IsNullOrEmpty(name) ? "A" : string.Concat(name.Split(' ').Select(w => w[0])).ToUpper();
}

<style>
    .sidebar-admin {
        width: var(--admin-sidebar-width);
        min-height: 100vh;
        background: #2A2A2A;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        padding: 24px;
        border-right: 1px solid #8b5cf6;
    }

    .admin-topbar {
        position: sticky;
        top: 0;
        z-index: 1020;
        background: #2A2A2A;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 10px 12px;
    }

    .admin-sidebar-offcanvas {
        width: var(--admin-sidebar-width);
        background: #2A2A2A;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
    }

    @@media (min-width: 992px) {

        .admin-sidebar-offcanvas {
            visibility: visible !important;
            transform: none !important;
            position: sticky;
            top: 0;
            height: 100vh;
            width: 300px !important;
            border-right: 1px solid rgba(255,255,255,0.08);
        }

            .admin-sidebar-offcanvas .offcanvas-body {
                padding: 0;
                height: 100%;
            }

        .sidebar-admin {
            width: 100%;
            height: 100%;
            min-height: 100vh;
        }

        .offcanvas-backdrop {
            display: none !important;
        }
    }

    @@media (max-width: 991.98px) {
        .admin-sidebar-offcanvas {
            width: 82vw;
            max-width: 320px;
        }

        .sidebar-admin {
            width: 100%;
            min-height: 100vh;
            padding: 20px 18px;
            border-right: none;
        }

        .sidebar-brand {
            margin-bottom: 16px;
        }

        .brand-icon-wrap {
            width: 34px;
            height: 34px;
            border-radius: 10px;
        }

        .brand-icon-wrap i {
            font-size: 1.1rem;
        }

        .brand-title {
            font-size: 1.2rem;
        }

        .sidebar-nav {
            gap: 6px;
        }

        .nav-item {
            padding: 8px 10px;
            border-radius: 16px;
            font-size: 13px;
            gap: 8px;
        }

        .nav-item i {
            font-size: 1rem;
        }
    }
    /* ADMIN PROFILE CARD */
    .admin-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 12px 14px;
        margin: 16px 0;
    }

    .admin-avatar {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #3a3a3a, #1f1f1f);
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
    }

    .admin-profile-name {
        font-size: 13.5px;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
    }

    .admin-profile-username {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.45);
        font-weight: 400;
        margin-top: 2px;
    }


    /* BRAND */
    .sidebar-brand {
        margin-bottom: 25px;
    }

    .brand-icon-wrap {
        width: 40px;
        height: 40px;
        background-color: #e8d84f;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .brand-icon-wrap i {
        font-size: 1.4rem;
        color: #2a2a2a;
        font-weight: 800
    }

    .brand-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: white;
        /* letter-spacing: -0.01em; */
    }



    .logo-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        margin-bottom: 10px;
    }

    .sidebar-brand h2 {
        font-size: 18px;
        margin: 0;
        font-weight: 600;
    }

 

    /* SECTION LABEL */
    .sidebar-section {
        margin-top: 15px;
    }

    .section-title {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: 1px;
        opacity: 0.5;
        margin-bottom: 8px;
        display: block;

    }

    /* NAV ITEMS */
    .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .nav-item i{
        font-size: 1.2rem;
    }

    .nav-item {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.6);
        padding: 10px 12px;
        border-radius: 20px;
        font-size: 14px;
        transition: 0.2s ease;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px; /* space between icon and text */
    }

        .nav-item:hover {
            color: rgba(255, 255, 255);
        }

        .nav-item.active {
            background: #e8d84f;
            color: #1e1e1e;
            font-weight: 700;
        }

    /* FOOTER */
    .sidebar-footer {
        margin-top: auto;
    }

    .logout-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.75);
        font-weight: 600;
        font-size: 13px;
        transition: 0.2s ease;
    }

        .logout-btn:hover {
            background: rgba(255, 70, 70, 0.15);
            border-color: rgba(255, 70, 70, 0.3);
            color: #ff6b6b;
        }

    .sidebar-footer small {
        font-size: 11px;
        opacity: 0.5;
    }
</style>

<div class="admin-topbar d-lg-none">
    <div class="d-flex align-items-center justify-content-between">
        <button class="btn btn-sm btn-outline-light"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#adminSidebar"
                aria-controls="adminSidebar">
            <i class="bi bi-list"></i>
        </button>

        <div class="d-flex gap-2 align-items-center">
            <div class="brand-icon-wrap" aria-hidden="true">
                <i class="bi bi-geo-alt"></i>
            </div>
            <div class="brand-title" style="font-size: 1.1rem;">FinderLink</div>
        </div>

        @* <div class="admin-profile">
            <div class="admin-avatar">@initials</div>
            <div>
                <div class="admin-profile-name">@name</div>
                <div class="admin-profile-username">&#64;@username</div>
            </div>
        </div> *@


        <div style="width: 36px;"></div>
    </div>
</div>

<div class="offcanvas offcanvas-start admin-sidebar-offcanvas"
     tabindex="-1"
     id="adminSidebar"
     aria-labelledby="adminSidebarLabel">

    <div class="offcanvas-header d-lg-none border-0"
         style="background:#2A2A2A;">
        
        <h5 class="offcanvas-title text-white"
            id="adminSidebarLabel">
            Menu
        </h5>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>
    </div>


    <div class="offcanvas-body p-0">
        <aside class="sidebar-admin">
            <div class="d-flex gap-2 align-items-center">
                <div class="brand-icon-wrap">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <div class="brand-title">FinderLink</div>
            </div>

            <div class="admin-profile">
                <div class="admin-avatar">@initials</div>

                <div style="min-width: 0;">
                    <div class="admin-profile-name">
                        @(string.IsNullOrEmpty(name) ? "Admin" : name)
                    </div>

                    <div class="admin-profile-username">
                        @@@(string.IsNullOrEmpty(username) ? "admin" : username)
                    </div>
                </div>
            </div>

            <div class="sidebar-section">
                <small class="section-title">MAIN</small>
                <nav class="sidebar-nav">
                    <a href="/dashboard/index" class="nav-item @(controller == "Dashboard" && action == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>

                    <a href="/manageitems/index" class="nav-item @(controller == "ManageItems" && action == "Index" ? "active" : "")">
                        <i class="bi bi-box-seam"></i> Manage Items
                    </a>

                    <a href="/reportloss/index" class="nav-item @(controller == "ReportLoss" && action == "Index" ? "active" : "")">
                        <i class="bi bi-exclamation-triangle"></i> Report Loss
                    </a>

                    <a href="/userclaims/index" class="nav-item @(controller == "UserClaims" && action == "Index" ? "active" : "")">
                        <i class="bi bi-person-check"></i> User Claims
                    </a>
                </nav>
            </div>

            <div class="sidebar-section">
                <small class="section-title">MANAGEMENT</small>
                <nav class="sidebar-nav">
                    <a href="/settings/index" class="nav-item @(controller == "Settings" && action == "Index" ? "active" : "")">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </nav>
            </div>

            <div class="sidebar-footer">
                <a href="/login/logout" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
                <small>Admin access only</small>
            </div>
        </aside>
    </div>
</div>

