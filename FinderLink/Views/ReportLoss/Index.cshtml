@model FinderLink.Models.ReportLossViewModel
<style>
    .card-dark {
        border-radius: 16px;
        padding: 2.2rem;
    }

    .input-div {
        display: flex;
        flex-direction: column;
    }

    label {
        font-size: 11px;
        font-weight: 600;
        color: #7a6f66;
        margin-bottom: 4px;
    }

        label span {
            color: #e5484d;
        }

    input, select, textarea {
        border-radius: 10px;
        border: 1px solid #e5e1dc;
        padding: 0.6rem 0.8rem;
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
        max-width: 100%;
        box-sizing: border-box;
    }

    /* FILE UPLOAD */
    .file-upload {
        border: 1px dashed #d6d1cb;
        border-radius: 12px;
        padding: 1.2rem;
        text-align: center;
        font-size: 13px;
        color: #9c8e82;
        cursor: pointer;
        position: relative;
        transition: 0.2s;
    }

    .file-preview {
        display: none;
        margin-top: 10px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #ece9f5;
        background: #FFFEFC;
    }

    .file-preview img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    .file-preview .file-preview-meta {
        padding: 10px 12px;
        font-size: 12px;
        color: #5C524A;
        font-family: 'Spline Sans Mono', monospace;
        border-top: 1px solid #eee;
    }

        .file-upload:hover {
            border-color: #e8d84f;
            background: rgba(232, 216, 79, 0.08);
        }

        .file-upload input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    /* BUTTONS */

    button{
        font-size: 12px;
    }

    .btn-clear {
        background: transparent;
        color: #5C524A;
        border-radius: 20px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        border: none;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-submit:hover {
            background: #1f1f1f;
        }

    /* RIGHT PANEL CARD */
    .recent-card {
        background: #FFFEFC;
        border: 1px solid #ece9f5;
        border-radius: 16px;
        padding: 1.5rem;
        height: 100%;
    }

    /* TITLE */
    .recent-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #5C524A;
        margin-bottom: 1rem;
       
    }

    /* LIST */
    .recent-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 400px;
        overflow-y: auto;
    }

    /* ITEM */
    .recent-item {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px;
        border-radius: 10px;
        transition: 0.2s;
        cursor: pointer;
        border: 1px solid rgba(92, 82, 74, 0.33);
    }

        .recent-item:hover {
            background: rgba(0,0,0,0.03);
        }

    /* IMAGE */
    .recent-img {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #f3f3f3;
        flex-shrink: 0;
    }

    /* TEXT */
    .recent-name {
        font-size: 13px;
        font-weight: 600;
        color: #1e1b2e;
    }

    .recent-desc {
        font-size: 11px;
        color: #9c8e82;
    }
</style>

<div class="page">
    <div class="page-header">
        <h1>Report Loss</h1>
        <p>Log a newly found item into the system</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card-dark">
            <div class="mb-4">
                <h6 class="fw-bold">New Item Report</h6>
            </div>

            <form id="reportLossForm" class="d-flex flex-column gap-4" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>ITEM NAME <span>*</span></label>
                        <input asp-for="ItemName" placeholder="Enter item name" />
                        <span asp-validation-for="ItemName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>ITEM CATEGORY <span>*</span></label>
                        <select asp-for="Category">
                            <option value="">Select Category</option>
                            @foreach (var category in (string[])ViewBag.Categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="input-div">
                    <label>ITEM DESCRIPTION <span>*</span></label>
                    <textarea asp-for="Description" rows="4" placeholder="Describe the item..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>LOCATION FOUND <span>*</span></label>
                        <select asp-for="LocationFound">
                            <option value="">Select Location</option>
                            @foreach (var location in (string[])ViewBag.Locations)
                            {
                                <option value="@location">@location</option>
                            }
                        </select>
                        <span asp-validation-for="LocationFound" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>DATE FOUND <span>*</span></label>
                        <input asp-for="DateFound" type="date" />
                        <span asp-validation-for="DateFound" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>FOUND BY <span>*</span></label>
                        <input asp-for="FoundByName" placeholder="Enter name" />
                        <span asp-validation-for="FoundByName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="input-div">
                        <label>CONTACT <span>*</span></label>
                        <input asp-for="FoundByContact" type="text" placeholder="Enter contact info" />
                        <span asp-validation-for="FoundByContact" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="input-div">
                    <label>ITEM PHOTO</label>
                    <div class="file-upload">
                        <i class="bi bi-upload"></i><br />
                        <span>Click to upload or drag image</span>
                        <input id="itemPhotoInput" asp-for="ItemPhoto" type="file" accept="image/*" />
                    </div>
                    <span asp-validation-for="ItemPhoto" class="text-danger"></span>

                    <div id="filePreview" class="file-preview">
                        <img id="filePreviewImg" alt="Selected item photo preview" />
                        <div id="filePreviewMeta" class="file-preview-meta"></div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-3">
                    <button type="reset" class="btn-clear">Clear Form</button>
                    <button id="submitBtn" type="submit" class="btn-submit">
                        <span id="submitIcon" class="bi bi-check-lg" aria-hidden="true"></span>
                        <span id="submitText">Submit Report</span>
                    </button>
                </div>

            </form>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card-dark recent-card">
                <p class="fw-semibold" style="font-size: 0.8rem;font-family: 'Spline Sans Mono', monospace; color: #5C524A;">RECENT ITEM REPORTS</p>

                @{
                    var recentItems = (List<FinderLink.Models.Item>)ViewBag.RecentItems;
                }

                @if (recentItems == null || recentItems.Count == 0)
                {
                    <div class="empty-state">No recent reports yet.</div>
                }
                else
                {
                    <div class="recent-list">
                        @foreach (var item in recentItems)
                        {
                            <div class="recent-item">
                                <img class="recent-img" src="@item.ImagePath" />
                                <div class="recent-info">
                                    <div class="recent-name">@item.ItemName</div>
                                    <div class="recent-desc">@item.Description</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('reportLossForm');
            const submitBtn = document.getElementById('submitBtn');
            const submitText = document.getElementById('submitText');
            const submitIcon = document.getElementById('submitIcon');

            const fileInput = document.getElementById('itemPhotoInput');
            const previewWrap = document.getElementById('filePreview');
            const previewImg = document.getElementById('filePreviewImg');
            const previewMeta = document.getElementById('filePreviewMeta');

            function isFormValid() {
                if (window.jQuery && window.jQuery(form) && window.jQuery(form).data('validator')) {
                    return window.jQuery(form).valid();
                }
                return form.checkValidity();
            }

            form.addEventListener('submit', function (e) {
                if (!isFormValid()) {
                    return;
                }

                submitBtn.disabled = true;
                submitIcon.className = 'spinner-border spinner-border-sm';
                submitIcon.setAttribute('role', 'status');
                submitIcon.setAttribute('aria-hidden', 'true');
                submitText.textContent = 'Submitting...';
            });

            fileInput.addEventListener('change', function () {
                const file = fileInput.files && fileInput.files[0];
                if (!file) {
                    previewWrap.style.display = 'none';
                    previewImg.removeAttribute('src');
                    previewMeta.textContent = '';
                    return;
                }

                const url = URL.createObjectURL(file);
                previewImg.src = url;
                previewMeta.textContent = file.name;
                previewWrap.style.display = 'block';
            });
        })();
    </script>
}