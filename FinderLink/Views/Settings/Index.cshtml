@model FinderLink.Models.SettingsViewModel;


<style>
    /* ===== TABS ONLY (no style changes to your cards) ===== */

    .settings-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #ece9f5;
        margin-bottom: 1.5rem;
    }

        .settings-tabs button {
            padding: 10px 14px;
            border: none;
            background: transparent;
            font-size: 13px;
            font-weight: 600;
            color: #7a6f66;
            border-bottom: 2px solid transparent;
            cursor: pointer;
        }

            .settings-tabs button.active {
                color: #1e1b2e;
                border-bottom: 2px solid #1e1b2e;
            }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .card-dark {
        background: #FFFEFC;
        border-radius: 16px;
        padding: 2.2rem;
        border: 1px solid #ece9f5;
    }

        .card-dark p {
            font-size: 0.8rem;
            /* font-weight: 500; */
            /* color: #9c8e82; */
        }

    .icon-wrapper {
        padding: 0.7rem 0.9rem;
        border-radius: 10px
    }

        .icon-wrapper i {
            font-size: 1.2rem;
        }

    label {
        font-size: 12px;
        font-weight: 500;
        color: #7a6f66;
        margin-bottom: 4px;
    }

        label span {
            color: #e5484d;
        }

    .input-div {
        display: flex;
        flex-direction: column;
    }

    input, select, textarea {
        border-radius: 10px;
        border: 1px solid #e5e1dc;
        padding: 0.6rem 0.8rem;
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
    }

    /* DO NOT TOUCH YOUR EXISTING CARD STYLES */
    .loc-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px; /* key upgrade: card spacing */
    }

        .loc-table thead th {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #9c8e82;
            padding: 0 14px 10px;
            text-align: left;
            border-bottom: 1px solid #ece9f5;
        }

        /* ROW = CARD */
        .loc-table tbody tr {
            background: #ffffff;
            transition: all 0.15s ease;
            box-shadow: 0 1px 0 rgba(0,0,0,0.03);
        }

            .loc-table tbody tr:hover {
                background: #fffdfb;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            }

        .loc-table td {
            padding: 14px;
            font-size: 13.5px;
            color: #1e1b2e;
            vertical-align: middle;
            border: none;
        }

        /* rounded row effect */
        .loc-table tbody tr td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        .loc-table tbody tr td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

    /* NAME */
    .loc-name {
        font-weight: 600;
        color: #1e1b2e;
    }

    /* STATUS */
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .badge-active {
        background: #eaf3de;
        color: #3b6d11;
    }

    .badge-inactive {
        background: #f1efe8;
        color: #5f5e5a;
    }

    /* ACTIONS */
    .btn-action {
        font-size: 12.5px;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 8px;
        border: 1px solid #e5e1dc;
        background: white;
        color: #3a3530;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .btn-action:hover {
            background: #f6f4f1;
            border-color: #d6d1ca;
        }

        /* PRIMARY ACTION (edit/save type) */
        .btn-action.primary {
            background: #1e1b2e;
            color: white;
            border: none;
        }

            .btn-action.primary:hover {
                background: #2a2740;
            }

</style>

<div class="page">

    <div class="page-header">
        <h1>Settings</h1>
        <p>Manage your account settings</p>
    </div>

    @if (TempData["SettingsMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3"
             role="alert"
             style="
            border:none;
            border-radius:14px;
            background:#eaf3de;
            color:#3b6d11;
            font-size:14px;
            ">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["SettingsMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["SettingsError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3"
             role="alert"
             style="
            border:none;
            border-radius:14px;
            background:#fde8e8;
            color:#b42318;
            font-size:14px;
            ">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["SettingsError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- TABS -->
    <div class="settings-tabs">
        <button class="tab-btn @(ViewBag.ActiveTab == "profile" ? "active" : "")" data-tab="profile">Profile</button>
        <button class="tab-btn @(ViewBag.ActiveTab == "security" ? "active" : "")" data-tab="security">Security</button>
    </div>

    <!-- ================= PROFILE ================= -->
    <div id="profile" class="tab-content active">

        <div class="card-dark">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-wrapper" style="background-color: #FDF9C4">
                    <i class="bi bi-person" style="color: #b8a900;"></i>
                </div>

                <div>
                    <p class="fw-bold" style="font-size: 1rem; margin-bottom: 0;">Profile Settings</p>
                    <p style="font-size: 0.85rem; margin-bottom: 0;">Update your account information</p>
                </div>
            </div>

            <form class="d-flex flex-column gap-4" method="post" asp-action="UpdateProfile">
                @Html.AntiForgeryToken()

                <div class="input-div">
                    <label>FULL NAME <span>*</span></label>
                    <input asp-for="Name" />
                </div>

                <div class="input-div">
                    <label>EMAIL <span>*</span></label>
                    <input asp-for="Email" />
                </div>

                <div class="input-div">
                    <label>USERNAME <span>*</span></label>
                    <input asp-for="Username" />
                </div>

                <div class="input-div">
                    <label>ROLE <span>*</span></label>
                    <input asp-for="Role" readonly />
                </div>

                <button style="background-color: #2a2a2a; color: white; border-radius: 20px; padding: 0.5rem 0;">
                    Save Changes
                </button>
            </form>
        </div>

    </div>

    <!-- ================= SECURITY ================= -->
    <div id="security" class="tab-content">

        <div class="card-dark">

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-wrapper" style="background-color: #FDE8F1">
                    <i class="bi bi-shield-lock" style="color: #c85a88;"></i>
                </div>

                <div>
                    <p class="fw-bold" style="font-size: 1rem; margin-bottom: 0;">Security Settings</p>
                    <p style="font-size: 0.85rem; margin-bottom: 0;">Password and access control</p>
                </div>
            </div>

            <form class="d-flex flex-column gap-4" method="post" asp-action="UpdatePassword">
                @Html.AntiForgeryToken()

                <div class="input-div">
                    <label>CURRENT PASSWORD <span>*</span></label>
                    <input asp-for="CurrentPassword" type="password" />
                </div>

                <div class="input-div">
                    <label>NEW PASSWORD <span>*</span></label>
                    <input asp-for="NewPassword" type="password" />
                </div>

                <div class="input-div">
                    <label>CONFIRM PASSWORD <span>*</span></label>
                    <input asp-for="ConfirmPassword" type="password" />
                </div>

                <button style="background-color: #2a2a2a; color: white; border-radius: 20px; padding: 0.5rem 0;">
                    Update Password
                </button>
            </form>

        </div>

    </div>


</div>

<div class="modal fade" id="editLocationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 14px;">

            <form method="post" asp-action="EditLocation">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Edit Location</h5>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="editLocationId" name="LocationId" />

                    <label class="form-label">Name</label>
                    <input class="form-control" id="editLocationName" name="Name" />

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn btn-dark">
                        Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

                document.addEventListener("DOMContentLoaded", function () {

            const activeTab = "@ViewBag.ActiveTab";

            if (activeTab) {
                document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
                document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));

                document.querySelector(`[data-tab="${activeTab}"]`)?.classList.add("active");
                document.getElementById(activeTab)?.classList.add("active");
            }
        });
        document.addEventListener("DOMContentLoaded", function () {

            const modal = document.getElementById('editLocationModal');

            modal.addEventListener('show.bs.modal', function (event) {

                const button = event.relatedTarget;

                const id = button.getAttribute('data-id');
                const name = button.getAttribute('data-name');

                document.getElementById('editLocationId').value = id;
                document.getElementById('editLocationName').value = name;
            });

        });
        const tabs = document.querySelectorAll(".tab-btn");
        const contents = document.querySelectorAll(".tab-content");

        tabs.forEach(btn => {
            btn.addEventListener("click", () => {

                tabs.forEach(b => b.classList.remove("active"));
                contents.forEach(c => c.classList.remove("active"));

                btn.classList.add("active");
                document.getElementById(btn.dataset.tab).classList.add("active");
            });
        });
    </script>
}
